<Window x:Class="Feather.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feather AV"
        Height="780" Width="1280"
        MinHeight="660" MinWidth="1040"
        Background="{StaticResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="#FF1E2025" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="22,22,20,8">
                    <Image Source="Assets/feather-logo.png" Width="204"
                           HorizontalAlignment="Left" Stretch="Uniform"
                           Margin="2,4,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,8,12,0">
                    <TextBlock Text="MENU" FontSize="10.5" FontWeight="Bold"
                               Foreground="#FF606873" Margin="14,0,0,12"/>

                    <Button x:Name="NavDashboard" Style="{StaticResource NavButton}"
                            Click="OnNavDashboard" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" Fill="Transparent"
                                  Data="M3,3 H10 V10 H3 Z M14,3 H21 V14 H14 Z M3,14 H10 V21 H3 Z M14,18 H21 V21 H14 Z"/>
                            <TextBlock Text="Dashboard" Margin="13,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavScan" Style="{StaticResource NavButton}"
                            Click="OnNavScan" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" Fill="Transparent"
                                  Data="M10.5,2.5 A8,8 0 1,0 10.5,18.5 A8,8 0 1,0 10.5,2.5 M16.3,16.3 L22,22"/>
                            <TextBlock Text="Scan" Margin="13,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavQuarantine" Style="{StaticResource NavButton}"
                            Click="OnNavQuarantine" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" Fill="Transparent"
                                  Data="M12,2.5 L20.5,6 V12 C20.5,17 16.8,20.8 12,21.7 C7.2,20.8 3.5,17 3.5,12 V6 Z M9,12 L11.3,14.4 L15.5,9.8"/>
                            <TextBlock Text="Quarantine" Margin="13,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavCategories" Style="{StaticResource NavButton}"
                            Click="OnNavCategories" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" Fill="Transparent"
                                  Data="M4,4 H20 V8 H4 Z M4,11 H20 V15 H4 Z M4,18 H20 V22 H4 Z"/>
                            <TextBlock Text="Categories" Margin="13,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}"
                            Click="OnNavSettings" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7" Fill="Transparent"
                                  Data="M4,6 H20 M4,12 H20 M4,18 H20 M8,3.5 V8.5 M16,9.5 V14.5 M12,15.5 V20.5"/>
                            <TextBlock Text="Settings" Margin="13,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="22,0,20,20">
                    <Border Height="1" Background="#FF24262B" Margin="0,0,0,14"/>
                    <TextBlock x:Name="EngineLabel" Text="engine: not found"
                               Foreground="#FF8A929E" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="real-time block + quarantine" FontSize="11"
                               Foreground="#FF626A76" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">

            <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,40">
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0"
                               Text="Feather AV classifies what it finds. Malware is wiped only when you choose to remove it; other findings stay restorable."/>

                    <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Background="#FF1B3442" CornerRadius="20"
                                        HorizontalAlignment="Left" Padding="11,5,11,5">
                                    <TextBlock Text="QUICK SCAN" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGlowBrush}"/>
                                </Border>
                                <TextBlock Text="Scan your device" FontSize="22" FontWeight="SemiBold"
                                           Margin="0,14,0,0"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                           Text="Scan system files and critical areas on drive C. Use Scan to choose another folder."/>
                                <TextBlock x:Name="LastScanLabel" Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0" Text="Last scan: never"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        Margin="28,0,0,0" Orientation="Horizontal">
                                <Button x:Name="DashboardScanButton" Content="Scan"
                                        Style="{StaticResource AccentButton}"
                                        Padding="30,14" FontSize="14" Click="OnDashboardScan"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,9,0" MinHeight="244">
                            <StackPanel>
                                <TextBlock Text="Protection Advisor" Style="{StaticResource SectionTitle}"/>
                                <StackPanel x:Name="AdvisorPanel" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0" MinHeight="244">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Security Status" Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Width="40" Height="40"
                                            CornerRadius="20" Background="#FF1B3A2B">
                                        <Path x:Name="StatusGlyph" Width="20" Height="20"
                                              Stretch="Uniform" Fill="{StaticResource SuccessBrush}"
                                              Data="M4,12 L9.5,17.5 L20,5 L22,7 L9.5,21 L2,13.5 Z"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="StatusHeadline" Text="Scanner ready"
                                           FontSize="19" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <TextBlock x:Name="StatusNote" Style="{StaticResource MutedText}"
                                           Margin="0,7,0,0"
                                           Text="On-demand scanning is available. Real-time protection is not part of this build."/>
                                <StackPanel x:Name="StatusDetails" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Protection Updates" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                           Text="Local signature database"/>
                                <TextBlock x:Name="DefinitionsLabel" Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0" Text="Checking..."/>
                            </StackPanel>
                            <Button x:Name="CheckDefinitionsButton" Grid.Column="1" Content="Check"
                                    Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                    Margin="20,0,0,0" Click="OnCheckDefinitions"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Real-time protection" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="RtStatusLabel" Text="Checking..."
                                           FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <TextBlock x:Name="RtDetailLabel" Style="{StaticResource MutedText}"
                                           Margin="0,5,0,0" Text="Reading service status..."/>
                                <TextBlock x:Name="RtStatsLabel" Style="{StaticResource MutedText}"
                                           Margin="0,5,0,0" Text=""/>
                                <StackPanel x:Name="RtEventsPanel" Margin="0,12,0,0"/>
                            </StackPanel>
                            <Button x:Name="RtRefreshButton" Grid.Column="1" Content="Refresh"
                                    Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                                    Margin="20,0,0,0" Click="OnRefreshRealtime"/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource MutedText}" Margin="0,18,0,0"
                               Text="Real-time protection blocks executable opens on a malicious/unwanted verdict and quarantines the file. It is only active when the kernel filter is loaded and the service is connected; see the status above."/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ScanPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,40">
                    <TextBlock Text="Scan" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0"
                               Text="One click scans drive C. Open the menu to scan a specific folder instead."/>

                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Scan your device" FontWeight="SemiBold" FontSize="17"/>
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                               Text="Classify findings, then decide what to do with each one."/>
                                </StackPanel>
                                <Button x:Name="MoreOptionsButton" Grid.Column="1"
                                        Content="&#x2026;" ToolTip="More options"
                                        Style="{StaticResource GhostButton}"
                                        Padding="14,8" Click="OnMoreOptions"/>
                            </Grid>

                            <Button x:Name="ScanButton"
                                    Style="{StaticResource AccentButton}"
                                    HorizontalAlignment="Left" Padding="34,15"
                                    FontSize="15" Margin="0,18,0,0" Click="OnScan">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Fill="#FF0B1218" Margin="0,0,11,0"
                                          Data="M2,1 L11,6 L2,11 Z"/>
                                    <TextBlock Text="Scan now" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#FF0B1218"/>
                                </StackPanel>
                            </Button>

                            <Border x:Name="FolderPanel" Visibility="Collapsed"
                                    Margin="0,18,0,0" Padding="14"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    CornerRadius="10" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Scan a specific folder" FontWeight="SemiBold"
                                               FontSize="13" Margin="0,0,0,9"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PathBox" Grid.Column="0"
                                                 Style="{StaticResource TextBox}"/>
                                        <Button x:Name="BrowseButton" Grid.Column="1"
                                                Content="Browse" Margin="10,0,0,0"
                                                Style="{StaticResource ButtonBase}" Click="OnBrowse"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ProgressBar x:Name="Progress" Visibility="Collapsed" Margin="0,20,0,0"
                                         IsIndeterminate="True"/>
                            <TextBlock x:Name="Status" Style="{StaticResource MutedText}"
                                       Text="Ready. Click Scan to check drive C."
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Findings" FontSize="19" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="FindingsCount" Style="{StaticResource Badge}"
                                    Background="#FF2D2F34" Margin="10,0,0,0">
                                <TextBlock Text="0" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="QuarantineButton" Content="Remove selected"
                                    ToolTip="Wipes malware permanently; quarantines other findings"
                                    Style="{StaticResource DangerButton}" Click="OnQuarantineChecked"/>
                            <Button x:Name="AllowButton" Content="Allow selected"
                                    Style="{StaticResource ButtonBase}" Margin="10,0,0,0"
                                    Click="OnAllowChecked"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ResultsPanel" Margin="0,16,0,30"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="QuarantinePage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,40">
                    <TextBlock Text="Quarantine" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0"
                               Text="Files are copied here, hash-named, and can be restored at any time."/>
                    <Button x:Name="RefreshQuarantineButton" Content="Refresh"
                            Style="{StaticResource ButtonBase}" HorizontalAlignment="Left"
                            Margin="0,22,0,0" Click="OnRefreshQuarantine"/>
                    <StackPanel x:Name="QuarantinePanel" Margin="0,16,0,30"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="CategoriesPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,40">
                    <TextBlock Text="Categories" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0"
                               Text="Choose what each category does by default. This only preselects checkboxes; it never deletes anything on its own."/>
                    <Border Style="{StaticResource Card}" Margin="0,24,0,30" Padding="10">
                        <StackPanel x:Name="CategoryPanel"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30,36,40">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0"
                               Text="Engine location, allow list and about this build."/>

                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Scanner engine" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="EnginePathLabel" Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0" Text="Not found"/>
                            <Button x:Name="LocateButton" Content="Locate feather.exe"
                                    Style="{StaticResource ButtonBase}" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" Click="OnLocate"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Allow list" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="AllowListLabel" Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0" Text=""/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Text="Hashes you allow are ignored by future scans. Malicious verdicts are never suppressed."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="About Feather AV" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       Text="Version 0.4.0  |  MIT licensed  |  On-demand + optional real-time"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Text="Classification, not condemnation. You decide what leaves your device."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>

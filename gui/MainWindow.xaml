<Window x:Class="Feather.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="feather"
        Height="760" Width="1140"
        MinHeight="620" MinWidth="940"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ sidebar ===========================-->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,0">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,26">
                        <Grid Width="34" Height="34">
                            <Ellipse Fill="{StaticResource AccentBrush}"/>
                            <Path Data="M 17,3 C 17,3 23,6 23,13 C 23,17 19.5,21 17,23 C 14.5,21 11,17 11,13 C 11,6 15,3 17,3 Z"
                                  Fill="White" Opacity="0.95" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Width="16" Height="20"
                                  Stretch="Fill"/>
                            <Line X1="17" Y1="5" X2="17" Y2="21" Stroke="White"
                                  StrokeThickness="0.8" Opacity="0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="feather" Foreground="White" FontSize="20"
                                   FontWeight="Bold" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="NavScan" Style="{StaticResource NavButton}"
                            Content="Scan" Click="OnNavScan"/>
                    <Button x:Name="NavQuarantine" Style="{StaticResource NavButton}"
                            Content="Quarantine" Click="OnNavQuarantine"/>
                    <Button x:Name="NavCategories" Style="{StaticResource NavButton}"
                            Content="Categories" Click="OnNavCategories"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,18">
                    <Border Height="1" Background="#FF26303E" Margin="0,0,0,14"/>
                    <TextBlock x:Name="EngineLabel" Text="engine: not found"
                               Foreground="#FF7C8798" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="alpha - classify, never auto-delete"
                               Foreground="#FF5C6778" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ content ==========================-->
        <Grid Grid.Column="1">

            <!-- = Scan page -->
            <ScrollViewer x:Name="ScanPage" VerticalScrollBarVisibility="Auto"
                          Padding="30">
                <StackPanel>
                    <TextBlock Text="Scan" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Pick a folder. feather classifies what it finds and leaves every decision to you."
                               Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Scan your device" FontWeight="SemiBold"
                                               FontSize="18"/>
                                    <TextBlock Text="One click scans your C drive for threats. Use the menu for a specific folder."
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="MoreOptionsButton" Grid.Column="1"
                                        Content="&#x22EF;" ToolTip="More options"
                                        Style="{StaticResource ButtonBase}"
                                        Padding="12,8" Click="OnMoreOptions"/>
                            </Grid>

                            <Button x:Name="ScanButton" Content="&#x25B6;  Scan now"
                                    Style="{StaticResource AccentButton}"
                                    HorizontalAlignment="Left" Padding="34,14"
                                    FontSize="15" Margin="0,14,0,0" Click="OnScan"/>

                            <Border x:Name="FolderPanel" Visibility="Collapsed"
                                    Margin="0,16,0,0" Padding="12"
                                    Background="#FFF3F5F9" CornerRadius="9"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Scan a specific folder"
                                               FontWeight="SemiBold" FontSize="13"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PathBox" Grid.Column="0"
                                                 Style="{StaticResource TextBox}"
                                                 VerticalContentAlignment="Center"/>
                                        <Button x:Name="BrowseButton" Grid.Column="1"
                                                Content="Browse" Margin="10,0,0,0"
                                                Style="{StaticResource ButtonBase}"
                                                Click="OnBrowse"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ProgressBar x:Name="Progress" Visibility="Collapsed"
                                         Margin="0,18,0,0" IsIndeterminate="True"/>
                            <TextBlock x:Name="Status" Style="{StaticResource MutedText}"
                                       Text="Ready. Click Scan to check your C drive."
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Findings" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="QuarantineButton" Content="Quarantine selected"
                                    Style="{StaticResource DangerButton}"
                                    Click="OnQuarantineChecked"/>
                            <Button x:Name="AllowButton" Content="Allow selected"
                                    Style="{StaticResource ButtonBase}"
                                    Margin="10,0,0,0" Click="OnAllowChecked"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ResultsPanel" Margin="0,14,0,30"/>
                </StackPanel>
            </ScrollViewer>

            <!-- = Quarantine page -->
            <ScrollViewer x:Name="QuarantinePage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="30">
                <StackPanel>
                    <TextBlock Text="Quarantine" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Files are copied here, hash-named, and can be restored at any time."
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="RefreshQuarantineButton" Content="Refresh"
                            Style="{StaticResource ButtonBase}" HorizontalAlignment="Left"
                            Margin="0,20,0,0" Click="OnRefreshQuarantine"/>
                    <StackPanel x:Name="QuarantinePanel" Margin="0,16,0,30"/>
                </StackPanel>
            </ScrollViewer>

            <!-- = Categories page -->
            <ScrollViewer x:Name="CategoriesPage" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="30">
                <StackPanel>
                    <TextBlock Text="Categories" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Choose what each category does by default. This only preselects checkboxes - it never deletes anything on its own."
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource Card}" Margin="0,22,0,30"
                            Padding="10">
                        <StackPanel x:Name="CategoryPanel"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
